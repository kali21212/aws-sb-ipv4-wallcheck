{
  "manifest_version": 3,
  "name": "AWS.SB IPv4 WallCheck Portable",
  "version": "1.6.0",
  "description": "Portable local IPv4 reachability monitor for aws.sb using ICMP plus TCP. IPv6 is ignored.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:17654/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://aws.sb/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}