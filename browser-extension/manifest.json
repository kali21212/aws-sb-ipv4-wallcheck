{
  "manifest_version": 3,
  "name": "AWS.SB IPv4 WallCheck Portable",
  "version": "1.9.1",
  "description": "Local IPv4 monitor for aws.sb: ICMP plus TCP 22; IPv6 may identify an instance but is never probed.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:17654/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aws.sb/*"
      ],
      "js": [
        "probe-isolation.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "WallCheck 手动 IP 监控",
    "default_popup": "manual-monitor.html"
  },
  "options_page": "manual-monitor.html"
}
